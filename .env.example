# ---- Twitch / IGDB (https://dev.twitch.tv/console/apps) ----
# IGDB auth is Twitch OAuth. Create an app, then use its Client ID + Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- Supabase ----
# Project ref is the subdomain of your project URL: https://<ref>.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role key. Local seed scripts only. NEVER ships in the app bundle,
# never committed, never referenced from an edge function that trusts the caller.
SUPABASE_SERVICE_ROLE_KEY=

# NOT CURRENTLY USED by any code. The seed writes through PostgREST using
# SUPABASE_SERVICE_ROLE_KEY (see scripts/supabase-admin.ts), not a direct Postgres
# connection. Leave blank unless you add a script that needs raw psql access.
# If you do: dashboard -> Project Settings -> Database -> Connection string (URI).
DATABASE_URL=

# ---- Seed tuning (see docs/spec.md section 2) ----
# Hackathon seed is a subset, not all 374k games.
SEED_RELEASED_SINCE=2023-01-01
SEED_MIN_POPULARITY=5
