# ---- Twitch / IGDB (https://dev.twitch.tv/console/apps) ----
# IGDB auth is Twitch OAuth. Create an app, then use its Client ID + Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- Supabase ----
# Project ref is the subdomain of your project URL: https://<ref>.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role key. Local seed scripts only. NEVER ships in the app bundle,
# never committed, never referenced from an edge function that trusts the caller.
SUPABASE_SERVICE_ROLE_KEY=

# NOT CURRENTLY USED by any code. The seed writes through PostgREST using
# SUPABASE_SERVICE_ROLE_KEY (see scripts/supabase-admin.ts), not a direct Postgres
# connection. Leave blank unless you add a script that needs raw psql access.
# If you do: dashboard -> Project Settings -> Database -> Connection string (URI).
DATABASE_URL=

# ---- Seed tuning (see docs/spec.md section 2) ----
# Hackathon seed is a subset, not all 305k main games. Two passes:
#   pass 1  everything released on or after SEED_RELEASED_SINCE   (~75,600 rows)
#   pass 2  everything BEFORE that date with at least
#           SEED_MIN_POPULARITY IGDB user ratings                 (~13,600 rows at 5)
# Pass 2 is what puts Elden Ring, The Witcher 3, GTA V, Cyberpunk 2077 and BotW in
# the catalog at all — a backlog is mostly old games, so a date-only seed misses
# the titles users actually have. Measured 7 Sep: >=5 adds 13,558 rows, >=20 adds
# 5,439, >=50 adds 2,694. Lower is safer here; a missing game is a dead end at the
# confirm screen, an extra obscure row just never ranks.
SEED_RELEASED_SINCE=2023-01-01
SEED_MIN_POPULARITY=5


# ---- Steam Web API (https://steamcommunity.com/dev/apikey) ----
# Requires a non-limited Steam account (at least $5 ever spent on it) and a domain
# name. Server-side only; never ships in the app bundle. Valve's API terms require
# a published privacy policy naming Steam before you ship.
STEAM_WEB_API_KEY=
STEAM_API_DOMAIN=

# ---- OpenXBL (https://xbl.io) ----
# The PUBLIC key from your xbl.io app registration. Free tier is 150 requests/hour,
# shared across the whole app rather than per user, which is why Xbox is import-only.
# The $5/month tier raises it to 500/hour. See docs/research/account-linking.md.
OPENXBL_API_KEY=

# ---- Account linking: where Steam / Xbox drop the user afterwards ----
# Each callback finishes as a 302 into the app. These are the base of that deep
# link; the function appends ?status=ok|failed|expired&nonce=... to it. Optional —
# default to shelf://link/steam and shelf://link/xbox. Set both to the app's real
# scheme (or an https:// universal link) once Sola confirms which one the app
# registers. Two separate values, not one shared base with the platform appended,
# because that is what the two callback functions already expect.
#
# NOTE: this and the three keys above must be set as SUPABASE SECRETS, not just
# here. Edge functions do not read .env in production:
#   npx supabase secrets set STEAM_WEB_API_KEY=... OPENXBL_API_KEY=... \
#     APP_LINK_RETURN_URL=... APP_LINK_RETURN_URL_XBOX=...
APP_LINK_RETURN_URL=
APP_LINK_RETURN_URL_XBOX=

# ---- DeepSeek (https://platform.deepseek.com) ----
# Sent by Josh 15 Sep 2026 IN PLACE OF an Anthropic key. Covers the LLM half of
# vague search (step 3 of docs/research/semantic-search.md §8 — "LLM names the
# game, grounded through shelf_search_games"). Models are `deepseek-flash` and
# `deepseek-v4-pro`; the API is OpenAI-shaped at https://api.deepseek.com.
#
# NOTE: DeepSeek has NO embeddings endpoint (/embeddings returns 404, checked
# 15 Sep 2026). It cannot stand in for Voyage. Step 5 (enrichment + embeddings
# + HyDE) still needs a Voyage key, which has not been sent.
#
# Both models are reasoning models: they spend completion tokens on hidden
# reasoning BEFORE the answer, so a small max_tokens returns an EMPTY string with
# finish_reason "length". Budget thousands of tokens even for one-line answers.
DEEPSEEK_API_KEY=
