{
  "name": "shelf-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shelf games catalog, share ingestion and roulette. Supabase + IGDB.",
  "scripts": {
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "seed:platforms": "tsx scripts/seed-platforms.ts",
    "seed:games": "tsx scripts/seed-games.ts",
    "seed:external-ids": "tsx scripts/seed-external-ids.ts",
    "seed": "npm run seed:platforms && npm run seed:games && npm run seed:external-ids",
    "backfill:ratings": "tsx scripts/backfill-rating-counts.ts",
    "verify:igdb": "tsx scripts/verify-igdb.ts",
    "smoke:oembed": "tsx scripts/smoke-oembed.ts",
    "functions:serve": "supabase functions serve --env-file .env",
    "functions:deploy": "supabase functions deploy",
    "typecheck": "tsc --noEmit",
    "verify:auth": "tsx scripts/verify-auth-rls.ts",
    "verify:functions": "tsx scripts/verify-functions.ts",
    "verify:roulette": "tsx scripts/verify-roulette.ts",
    "verify:share": "tsx scripts/verify-share.ts",
    "measure:share": "tsx scripts/measure-share-hitrate.ts",
    "verify:social": "tsx scripts/verify-social.ts",
    "verify:friends-popular": "tsx scripts/verify-popular-with-friends.ts",
    "verify:notifications": "tsx scripts/verify-notifications.ts",
    "verify:wishlist": "tsx scripts/verify-wishlist.ts",
    "verify:linking": "tsx scripts/verify-account-linking.ts",
    "verify:search-filters": "tsx scripts/verify-search-filters.ts",
    "lab:steam-library": "tsx scripts/link-lab/real-steam-library.ts",
    "lab:xbox-bridge": "tsx scripts/link-lab/xbox-title-bridge.ts",
    "verify:descriptive": "tsx scripts/search-lab/verify-descriptive-mapping.ts",
    "lab:eval": "tsx scripts/search-lab/run-eval.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "supabase": "^2.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
